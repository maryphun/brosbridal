---
import PageView from '../../components/Page.astro';
import {languages,pageKeys,type Lang,type Page} from '../../i18n';
export function getStaticPaths(){return languages.flatMap(lang=>pageKeys.map(page=>({params:{lang,page:page==='home'?undefined:page},props:{lang,page}})));}
const {lang,page}=Astro.props as {lang:Lang;page:Page};
---
<PageView lang={lang} page={page}/>
