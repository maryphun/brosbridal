---
import Layout from '../layouts/Layout.astro';
import Home from './Home.astro';
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import Packages from './Packages.astro';
import {copy,path,type Lang,type Page} from '../i18n';
import {services,gallery,gowns,packages} from '../data/content';
import {business} from '../data/business';
import {imageUrl} from '../lib/media';
interface Props {lang:Lang;page:Page;dress?:typeof gowns[number]}
const {lang,page,dress}=Astro.props; const t=copy[lang];
const categories=['all','pre-wedding','studio','outdoor','wedding-day','rom'];
const title=dress?dress.title[lang]:page==='home'?business.slogan:t.nav[['home','services','gowns','portfolio','packages','about','contact'].indexOf(page)];
---
<Layout lang={lang} page={page} title={title} route={dress?`gowns/${dress.id}`:page}>
{page==='home' && <Home lang={lang}/> }
{page==='services' && <><section class="page-heading section-wrap"><h1>{t.servicePageTitle}</h1><p>{t.servicePageBody}</p></section><div class="service-list section-wrap">{services.map(s=><section class="service-row" id={s.id}><h2>{s.title[lang]}</h2><p>{s.description[lang]}</p></section>)}</div></>}
{page==='gowns' && !dress && <>
 <section class="page-heading section-wrap"><h1 class="lines">{t.gownsPageTitle}</h1><p>{t.gownsPageBody}</p></section>
 <section class="catalog section-wrap" data-gown-catalog><div class="filter-bar"><div class="filter-field"><label for="style-filter">{t.style}</label><select id="style-filter"><option value="all">{t.all}</option><option value="minimal">{t.minimal}</option><option value="romantic">{t.romantic}</option></select></div><div class="filter-field"><label for="silhouette-filter">{t.silhouette}</label><select id="silhouette-filter"><option value="all">{t.all}</option><option value="aline">{t.aline}</option><option value="fitted">{t.fitted}</option></select></div></div><p class="catalog-note">{t.catalogNote}</p><div class="gown-grid">{gowns.map(g=><article data-style={g.style} data-silhouette={g.silhouette}><a class="gown-card" href={path(lang,`gowns/${g.id}`)}><div class="image-frame"><Photo id={g.images[0]} lang={lang}/></div><div class="gown-card-title"><h2>{g.title[lang]}</h2><span>{g.silhouette==='aline'?t.aline:t.fitted}</span></div><span class="small-label">{t.inspiration}</span></a></article>)}</div><div class="empty-state" data-empty hidden><p>{t.empty}</p><button class="text-link" data-clear-filters>{t.clear}<Arrow/></button></div></section>
</>}
{dress && <section class="dress-detail section-wrap"><a class="text-link back-link" href={path(lang,'gowns')}>{t.back}</a><div class="dress-grid"><div><button type="button" class="dress-main" data-lightbox data-image={imageUrl(dress.images[0])} data-caption={dress.title[lang]} aria-label={`${t.full}: ${dress.title[lang]}`}><Photo id={dress.images[0]} lang={lang} eager/></button><div class="dress-thumbnails">{dress.images.map((id,i)=><button type="button" data-dress-thumb={id} aria-label={`${t.photo} ${i+1}`} aria-pressed={i===0}><Photo id={id} lang={lang}/></button>)}</div></div><div class="dress-info"><h1>{dress.title[lang]}</h1><p>{dress.description[lang]}</p><dl><div><dt>{t.style}</dt><dd>{dress.style==='minimal'?t.minimal:t.romantic}</dd></div><div><dt>{t.silhouette}</dt><dd>{dress.silhouette==='aline'?t.aline:t.fitted}</dd></div></dl><h2>{t.sizes}</h2><p>{dress.sizes?.length?dress.sizes.join(lang==='zh'?'、':', '):t.sizesNote}</p><a class="button" href={`${path(lang,'contact')}?interest=gowns&dress=${dress.id}`}>{t.dressEnquire}<Arrow/></a><p class="catalog-note">{t.catalogNote}</p></div></div></section>}
{page==='portfolio' && <><section class="page-heading section-wrap"><h1 class="lines">{t.portfolioTitle}</h1><p>{t.portfolioBody}</p></section><section class="portfolio section-wrap" data-portfolio><div class="portfolio-filters" role="group" aria-label={t.nav[3]}>{categories.map((cat,i)=><button type="button" data-category={cat} aria-pressed={i===0}>{t.categories[i]}</button>)}</div><p class="result-count" aria-live="polite"><span data-count>{gallery.length}</span> {t.result}</p><div class="masonry">{gallery.map((p,i)=><figure data-categories={p.categories.join(' ')}><button type="button" data-lightbox data-image={imageUrl(p.id)} data-caption={p.alt[lang]} aria-label={`${t.full}: ${p.alt[lang]}`}><Photo id={p.id} lang={lang} eager={i<2}/><span class="expand-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 8V3h5M12 3h5v5M17 12v5h-5M8 17H3v-5" stroke="currentColor" stroke-width="1.3"/></svg></span></button></figure>)}</div><div class="empty-state" data-empty hidden><p>{t.empty}</p><button class="text-link" data-clear-filters>{t.clear}<Arrow/></button></div></section></>}
{page==='packages' && <><section class="page-heading section-wrap"><h1>{t.packagesPageTitle}</h1><p>{t.packagesPageBody}</p></section><section class="section-wrap package-page"><Packages lang={lang}/><p class="package-note">{t.packageNote}</p></section></>}
{page==='about' && <section class="about-intro section-wrap"><div><h1>{t.aboutTitle}</h1><p class="lead">{t.aboutBody}</p><p>{t.aboutSecond}</p><p>{t.aboutThird}</p></div><div class="about-photo"><Photo id="main-3" lang={lang} eager/></div></section>}
{page==='contact' && <section class="contact section-wrap"><div class="contact-intro"><h1 class="lines">{t.contactTitle}</h1><p>{t.contactBody}</p><p class="contact-location">{t.location}</p></div><div class="contact-form-wrap"><form id="enquiry-form" data-whatsapp={business.whatsapp} data-date-error={t.dateError} data-copied={t.copied} data-copy-failed={t.copyFailed}>
 <div class="form-field"><label for="name">{t.form[0]} <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required maxlength="100"/></div>
 <div class="form-field"><label for="service">{t.form[1]} <span aria-hidden="true">*</span></label><select id="service" name="service" required><option value="">{t.choose}</option>{services.map(s=><option value={s.id}>{s.title[lang]}</option>)}{packages.map(p=><option value={p.id}>{p.title[lang]}</option>)}<option value="exploring">{t.undecided}</option></select></div>
 <details class="form-details"><summary>{t.optionalDetails}</summary><div class="form-row"><div class="form-field"><label for="wedding-date">{t.form[2]}<small>{t.optional}</small></label><input type="date" id="wedding-date" name="wedding-date"/></div><div class="form-field"><label for="consultation-date">{t.form[3]}<small>{t.optional}</small></label><input type="date" id="consultation-date" name="consultation-date"/></div></div>
 <div class="form-field"><label for="budget">{t.form[4]}</label><select id="budget" name="budget">{t.budgetOptions.map(b=><option>{b}</option>)}</select></div>
 <div class="form-field"><label for="message">{t.form[5]}<small>{t.optional}</small></label><textarea id="message" name="message" rows="4" maxlength="2000"></textarea></div>
 </details>
 <input type="hidden" name="dress" id="dress-interest" data-label={t.nav[2]} data-names={JSON.stringify(Object.fromEntries(gowns.map(g=>[g.id,g.title[lang]])))}/><p class="form-hint">{t.formHint}</p><button type="submit" class="button">{t.prepare}<Arrow/></button>
 </form><section id="enquiry-preview" class="enquiry-preview" hidden aria-live="polite" tabindex="-1"><h2>{t.preview}</h2><textarea id="prepared-message" readonly rows="10" aria-label={t.preview}></textarea>{!business.whatsapp && <p>{t.noNumber}</p>}<div class="preview-actions">{business.whatsapp && <a class="button" id="send-whatsapp" target="_blank" rel="noopener noreferrer">{t.openWhatsApp}<Arrow/></a>}<button type="button" class="text-link" id="copy-message">{t.copyMessage}<Arrow/></button></div><p id="copy-status" role="status"></p></section></div></section>}
{(page==='portfolio'||dress) && <dialog id="lightbox" aria-label={t.full}><div class="lightbox-toolbar"><span id="lightbox-count"></span><div><button type="button" id="fullscreen" aria-label={t.full}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 8V3h5M12 3h5v5M17 12v5h-5M8 17H3v-5" stroke="currentColor" stroke-width="1.3"/></svg></button><button type="button" id="close-lightbox" aria-label={t.close}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><path d="m4 4 14 14M18 4 4 18" stroke="currentColor" stroke-width="1.3"/></svg></button></div></div><button class="lightbox-prev" type="button" aria-label={t.previous}><Arrow/></button><figure><img id="lightbox-image" src={imageUrl("main-1",true)} loading="lazy" alt=""/><figcaption id="lightbox-caption"></figcaption></figure><button class="lightbox-next" type="button" aria-label={t.next}><Arrow/></button></dialog>}
</Layout>
