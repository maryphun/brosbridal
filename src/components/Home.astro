---
import { copy, path, type Lang } from '../i18n';
import { services } from '../data/content';
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import Packages from './Packages.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const featured = [
  { service: services[0], destination: 'portfolio' },
  { service: services[4], destination: 'gowns' },
  { service: services[3], destination: 'services#beauty' },
];
---
<section class="hero">
  <div class="hero-copy">
    <h1><span>{t.hero[0]}</span> <em>{t.hero[1]} <span class="no-wrap">{t.hero[2]}</span></em></h1>
    <p>{t.heroBody}</p>
    <a class="button" href={path(lang, 'contact')}>{t.book}<Arrow /></a>
  </div>
  <div class="hero-photo"><Photo id="main-1" lang={lang} eager /></div>
</section>

<section class="services-home section-wrap">
  <div class="section-heading">
    <div><h2>{t.servicesTitle}</h2><p>{t.servicesBody}</p></div>
    <a class="text-link" href={path(lang, 'services')}>{t.viewAll}<Arrow /></a>
  </div>
  <div class="service-features">
    {featured.map(({ service, destination }) => (
      <a class="service-feature" href={destination.includes('#') ? `${path(lang, 'services')}#beauty` : path(lang, destination)}>
        <div class="image-frame"><Photo id={service.image} lang={lang} /></div>
        <div class="feature-title"><h3>{service.title[lang]}</h3><Arrow /></div>
      </a>
    ))}
  </div>
</section>

<section class="packages-section section-wrap">
  <div class="section-heading"><div><h2>{t.packageTitle}</h2><p>{t.packageBody}</p></div></div>
  <Packages lang={lang} compact />
  <a class="text-link package-details" href={path(lang, 'packages')}>{t.explore}<Arrow /></a>
</section>

<section class="faq section-wrap">
  <h2>{t.faqTitle}</h2>
  <div>{[t.faqs[0], t.faqs[1], t.faqs[3]].map(([question, answer]) => (
    <details><summary>{question}<span aria-hidden="true"></span></summary><p>{answer}</p></details>
  ))}</div>
</section>
