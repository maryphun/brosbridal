---
import { packages } from '../data/content';
import { business } from '../data/business';
import { copy, path, type Lang } from '../i18n';
import Arrow from './Arrow.astro';
const {lang,compact=false}=Astro.props as {lang:Lang;compact?:boolean}; const t=copy[lang];
---
<div class:list={['package-grid',{'package-compact':compact}]}>
 {packages.map(p=><article class="package" id={p.id}>
  <div class="package-copy"><h3>{p.title[lang]}</h3>
  {business.showPrices && p.price!==null && <p class="price">{t.price} {new Intl.NumberFormat(lang==='zh'?'zh-MY':lang==='ms'?'ms-MY':'en-MY',{style:'currency',currency:'MYR'}).format(p.price)}</p>}
  {!compact && <><h4>{t.included}</h4><ul>{p.includes.map(item=><li>{item[lang]}</li>)}</ul><details class="package-extras"><summary>{t.extras}</summary><ul>{p.extras.map(item=><li>{item[lang]}</li>)}</ul></details></>}
  <a class="text-link" href={compact?`${path(lang,'services')}#${p.id}`:`${path(lang,'contact')}?interest=${p.id}`}>{compact?t.details:t.quote}<Arrow/></a></div>
 </article>)}
</div>
