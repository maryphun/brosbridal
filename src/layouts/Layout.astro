---
import '@fontsource/bodoni-moda/latin-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '../styles/global.css';
import {business} from '../data/business';
import {copy,languages,languageNames,htmlLanguages,pageKeys,path,type Lang,type Page} from '../i18n';
import Arrow from '../components/Arrow.astro';
interface Props {lang:Lang;page:Page;title?:string;route?:string;description?:string;}
const {lang,page,title,route=page,description}=Astro.props; const t=copy[lang];
const canonical=business.siteUrl?new URL(path(lang,route),business.siteUrl).href:null;
const chatHref=business.whatsapp?`https://wa.me/${business.whatsapp}?text=${encodeURIComponent(t.book)}`:path(lang,'contact');
---
<!doctype html>
<html lang={htmlLanguages[lang]}>
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title || t.nav[pageKeys.indexOf(page)]} | {business.name} · Kuala Lumpur & Selangor</title>
  <meta name="description" content={description||t.heroBody}/><meta name="theme-color" content="#f5f2ec"/>
  {!business.published && <meta name="robots" content="noindex, nofollow"/>}
  {canonical && <link rel="canonical" href={canonical}/>}
  {business.siteUrl && languages.map(l=><link rel="alternate" hreflang={htmlLanguages[l]} href={new URL(path(l,route),business.siteUrl).href}/>)}
  <meta property="og:type" content="website"/><meta property="og:locale" content={htmlLanguages[lang].replaceAll('-','_')}/>
  <meta property="og:title" content={`${title||t.nav[pageKeys.indexOf(page)]} | ${business.name}`}/><meta property="og:description" content={description||t.heroBody}/>
  <meta property="og:image" content={business.siteUrl?new URL('/images/main-4.webp',business.siteUrl).href:'/images/main-4.webp'}/>
  {canonical && <meta property="og:url" content={canonical}/>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
 </head>
 <body data-lang={lang}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header">
   <a class="wordmark" href={path(lang)} aria-label={`${business.name} — ${t.nav[0]}`}><span>{business.name}</span></a>
   <nav class="desktop-nav" aria-label={t.menu}>{pageKeys.slice(1,4).map((p,i)=><a href={path(lang,p)} aria-current={page===p?'page':undefined}>{t.nav[i+1]}</a>)}</nav>
   <div class="header-actions"><label class="sr-only" for="language">{t.language}</label><select id="language" data-language-switch data-route={route}>{languages.map(l=><option value={l} selected={lang===l}>{languageNames[l]}</option>)}</select><a class="header-cta" href={chatHref}>{t.book}<Arrow/></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={t.menu}><span></span><span></span></button></div>
   <nav id="mobile-nav" class="mobile-nav" aria-label={t.menu} hidden>{pageKeys.map((p,i)=><a href={path(lang,p)} aria-current={page===p?'page':undefined}>{t.nav[i]}</a>)}</nav>
  </header>
  <main id="main"><slot/></main>
  {page!=='contact' && <section class:list={['consultation-banner',{'services-enquiry':page==='services'}]}><div><h2>{t.ctaTitle}</h2><p>{t.ctaBody}</p><a class="button button-light" href={chatHref}>{page==='services'?t.enquire:t.book}<Arrow/></a></div></section>}
  <footer class="site-footer"><div class="footer-top"><div><a class="footer-wordmark" href={path(lang)}>{business.name}</a><p>{t.footer}</p></div><nav aria-label={t.nav[0]}>{pageKeys.slice(1).map((p,i)=><a href={path(lang,p)}>{t.nav[i+1]}</a>)}</nav><div class="footer-contact"><span>{t.location}</span><a class="text-link" href={chatHref}>{t.chat}<Arrow/></a>{business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}{business.address && <p>{business.address}</p>}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {business.name}</span><span>{t.rights}</span></div>{business.imageNotice && <p class="image-notice">{t.imageNote}</p>}</footer>
  <a class="sticky-chat" href={chatHref}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M20 11.5a8 8 0 0 1-11.8 7l-4.7 1 1-4.6A8 8 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.4"/><path d="M9 8.5c0 3 1.5 4.5 4.5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>{t.chat}</a>
  <script>import '../scripts/site';</script>
 </body>
</html>
